  "lyrics": [
    { "lineNumber": 1, "startTime": 15.16, "endTime": 18.16, "original": "برای توی کوچه رقصیدن", "transliteration": "Barāye tūye kūche raqsidan", "hebrew": "בָּרָאיֶה טוּיֶה כּוּצֶ'ה רַקְסִידַן", "english": "For dancing in the alley" },
    { "lineNumber": 2, "startTime": 17.81, "endTime": 21.61, "original": "برای ترسیدن به وقت بوسیدن", "transliteration": "Barāye tarsidan be vaqt-e būsidan", "hebrew": "בָּרָאיֶה טַרְסִידַן בֶּה וַקְטֶה בּוּסִידַן", "english": "For being afraid at the moment of kissing" },
    { "lineNumber": 3, "startTime": 21.26, "endTime": 25.33, "original": "برای خواهرم خواهرت خواهرامون", "transliteration": "Barāye khāharam khāharet khāharāmūn", "hebrew": "בָּרָאיֶה חָאהַרַם חָאהַרֶת חָאהַרָמוּן", "english": "For my sister, your sister, our sisters" },
    { "lineNumber": 4, "startTime": 24.98, "endTime": 29.31, "original": "برای تغییر مغزها که پوسیدن", "transliteration": "Barāye taghyir-e maghz-hā ke pūsidan", "hebrew": "בָּרָאיֶה תַגְ'יִירֶה מַגְ'זְהָא כֶּה פּוּסִידַן", "english": "For changing the minds that have rotted" },
    { "lineNumber": 5, "startTime": 28.96, "endTime": 33.03, "original": "برای شرمندگی، برای بی پولی", "transliteration": "Barāye sharmandegi, Barāye bi-pūli", "hebrew": "בָּרָאיֶה שַׁרְמַנְדֶגִי, בָּרָאיֶה בִּיפּוּלִי", "english": "For shame, for being penniless" },
    { "lineNumber": 6, "startTime": 32.68, "endTime": 36.48, "original": "برای حسرت یک زندگی معمولی", "transliteration": "Barāye hasrat-e yek zendegi-ye ma'mūli", "hebrew": "בָּרָאיֶה חַסְרַטֶה יֶק זֶנְדֶגִיֶה מַעְמוּלִי", "english": "For the longing for an ordinary life" },
    { "lineNumber": 7, "startTime": 36.13, "endTime": 40.20, "original": "برای کودک زباله گرد و آرزوهاش", "transliteration": "Barāye kūdak-e zobālegard o ārezūhāsh", "hebrew": "בָּרָאיֶה כּוּדַכֶּה זוּבָּלֶגַרְד אוֹ אָרֶזוּהָאש", "english": "For the scavenger child and his dreams" },
    { "lineNumber": 8, "startTime": 39.85, "endTime": 43.92, "original": "برای این اقتصاد دستوری", "transliteration": "Barāye in eqtesād-e dastūri", "hebrew": "בָּרָאיֶה אִין אֶקְטֶסָאדֶה דַסְטוּרִי", "english": "For this controlled economy" },
    { "lineNumber": 9, "startTime": 43.57, "endTime": 47.64, "original": "برای این هوای آلوده", "transliteration": "Barāye in havā-ye ālūde", "hebrew": "בָּרָאיֶה אִין הַוָאיֶה אָלוּדֶה", "english": "For this polluted air" },
    { "lineNumber": 10, "startTime": 47.29, "endTime": 51.36, "original": "برای ولیعصر و درختان فرسوده", "transliteration": "Barāye Vali-'asr o derakht-hāye farsūde", "hebrew": "בָּרָאיֶה וַלִיעַסְר אוֹ דֶרַחְטְהָאיֶה פַרְסוּדֶה", "english": "For Valiasr and its dying trees" },
    { "lineNumber": 11, "startTime": 51.01, "endTime": 55.08, "original": "برای پیروز و احتمال انقراضش", "transliteration": "Barāye Pirūz o ehtemāl-e enqerāzesh", "hebrew": "בָּרָאיֶה פִּירוּז אוֹ אֶחְתֶמָאלֶה אֶנְקֶרָאזֶש", "english": "For Pirouz and the possibility of its extinction" },
    { "lineNumber": 12, "startTime": 54.73, "endTime": 58.80, "original": "برای سگهای بی گناه ممنوعه", "transliteration": "Barāye sag-hāye bi-gonāh-e mamnū'e", "hebrew": "בָּרָאיֶה סַגְהָאיֶה בִּיגוּנָאהֶה מַמְנוּעֶה", "english": "For the innocent dogs that are banned" },
    { "lineNumber": 13, "startTime": 58.45, "endTime": 62.51, "original": "برای گریه های بی وقفه", "transliteration": "Barāye gerye-hāye bi-vaqfe", "hebrew": "בָּרָאיֶה גֶרְיֶהָאיֶה בִּיוַקְפֶה", "english": "For the endless crying" },
    { "lineNumber": 14, "startTime": 62.16, "endTime": 66.00, "original": "برای تصویر تکرار این لحظه", "transliteration": "Barāye tasvir-e tekrār-e in lahze", "hebrew": "בָּרָאיֶה טַסְוִירֶה טֶכְרָארֶה אִין לַחְזֶה", "english": "For the image of repeating this moment" },
    { "lineNumber": 15, "startTime": 65.65, "endTime": 69.73, "original": "برای چهره ای که میخنده", "transliteration": "Barāye chehre-'i ke mikhande", "hebrew": "בָּרָאיֶה צֶ'הְרֶאִי כֶּה מִיחַנְדֶה", "english": "For a face that is laughing" },
    { "lineNumber": 16, "startTime": 69.38, "endTime": 73.45, "original": "برای دانش آموزا برای آینده", "transliteration": "Barāye dānesh-āmūz-hā, Barāye āyande", "hebrew": "בָּרָאיֶה דָאנֶשְׁאָמוּזְהָא, בָּרָאיֶה אָיַנְדֶה", "english": "For the students, for the future" },
    { "lineNumber": 17, "startTime": 73.10, "endTime": 77.97, "original": "برای این بهشت اجباری", "transliteration": "Barāye in behesht-e ejbāri", "hebrew": "בָּרָאיֶה אִין בֶּהֶשְׁטֶה אֶג'בָּארִי", "english": "For this forced paradise" },
    { "lineNumber": 18, "startTime": 77.62, "endTime": 84.64, "original": "برای نخبه های زندانی", "transliteration": "Barāye nokhbe-hāye zendāni", "hebrew": "בָּרָאיֶה נוֹחְבֶּהָאיֶה זֶנְדָאנִי", "english": "For the imprisoned intellectuals" },
    { "lineNumber": 19, "startTime": 84.29, "endTime": 85.17, "original": "برای کودکان افغانی", "transliteration": "Barāye kūdakān-e Afghāni", "hebrew": "בָּרָאיֶה כּוּדַכָּאנֶה אַפְגָ'אנִי", "english": "For the Afghan children" },
    { "lineNumber": 20, "startTime": 84.82, "endTime": 88.09, "original": "برای این همه برای غیر تکراری", "transliteration": "Barāye in hame barāye gheire tekrāri", "hebrew": "בָּרָאיֶה אִין הַמֶה בָּרָאיֶה גֵ'ירֶה טֶכְרָארִי", "english": "For all these 'for's that are not repetitive" },
    { "lineNumber": 21, "startTime": 87.74, "endTime": 92.08, "original": "برای اینهمه شعار های تو خالی", "transliteration": "Barāye in hame sho'ār-hāye tū-khāli", "hebrew": "בָּרָאיֶה אִין הַמֶה שׁוֹעָארְהָאיֶה טוּחָאלִי", "english": "For all these empty slogans" },
    { "lineNumber": 22, "startTime": 91.73, "endTime": 95.53, "original": "برای آوار خونه های پوشالی", "transliteration": "Barāye āvār-e khāne-hāye pūshāli", "hebrew": "בָּרָאיֶה אָוָארֶה חָאנֶהָאיֶה פּוּשָׁאלִי", "english": "For the rubble of houses made of straw" },
    { "lineNumber": 23, "startTime": 95.18, "endTime": 99.25, "original": "برای احساس آرامش", "transliteration": "Barāye ehsās-e ārāmesh", "hebrew": "בָּרָאיֶה אֶחְסָאסֶה אָרָאמֶש", "english": "For the feeling of peace" },
    { "lineNumber": 24, "startTime": 98.90, "endTime": 102.97, "original": "برای خورشید پس از شبای طولانی", "transliteration": "Barāye khorshid pas az shab-hāye tūlāni", "hebrew": "בָּרָאיֶה חוֹרְשִׁיד פַּס אַז שַׁבְּהָאיֶה טוּלָאנִי", "english": "For the sun after the long nights" },
    { "lineNumber": 25, "startTime": 102.62, "endTime": 106.69, "original": "برای قرصهای اعصاب و بی خوابی", "transliteration": "Barāye qors-hāye a'sāb o bi-khābi", "hebrew": "בָּרָאיֶה קוֹרְסְהָאיֶה אַעְסָאב אוֹ בִּיחָאבִּי", "english": "For the nerve pills and insomnia" },
    { "lineNumber": 26, "startTime": 106.34, "endTime": 110.41, "original": "برای مـرد، میهن، آبادی", "transliteration": "Barāye mard, mihan, ābādi", "hebrew": "בָּרָאיֶה מַרְד, מִיהַן, אָבָּאדִי", "english": "For man, homeland, prosperity" },
    { "lineNumber": 27, "startTime": 110.06, "endTime": 114.13, "original": "برای دختری که آرزو داشت پسر بود", "transliteration": "Barāye dokhtari ke ārezū dāsht pesar būd", "hebrew": "בָּרָאיֶה דוֹחְטַרִי כֶּה אָרֶזוּ דָאשְׁט פֶּסַר בּוּד", "english": "For the girl who wished she was a boy" },
    { "lineNumber": 28, "startTime": 113.78, "endTime": 124.26, "original": "برای زن، زندگی، آزادی", "transliteration": "Barāye zan, zendegi, āzādi", "hebrew": "בָּרָאיֶה זַן, זֶנְדֶגִי, אָזָאדִי", "english": "For woman, life, freedom" },
    { "lineNumber": 29, "startTime": 123.91, "endTime": 131.51, "original": "بــــرای آزادی", "transliteration": "Barāye āzādi", "hebrew": "בָּרָאיֶה אָזָאדִי", "english": "For freedom" },
    { "lineNumber": 30, "startTime": 131.16, "endTime": 138.85, "original": "بـــرای آزادی", "transliteration": "Barāye āzādi", "hebrew": "בָּרָאיֶה אָזָאדִי", "english": "For freedom" },
    { "lineNumber": 31, "startTime": 138.50, "endTime": 151.46, "original": "بـــرای آزادی", "transliteration": "Barāye āzādi", "hebrew": "בָּרָאיֶה אָזָאדִי", "english": "For freedom" }
