#!/usr/bin/env python3
"""
SongScript WhisperX CLI - Unified tool for song timestamp generation.

Usage:
  songscript-whisperx add <youtube_url> <language> [options]
  songscript-whisperx extract <audio_file> <language> [options]
  songscript-whisperx match <whisperx_output> <lyrics_file> [options]
  songscript-whisperx apply <timestamps_json> <song_id>

Examples:
  # Full pipeline: YouTube URL to database
  songscript-whisperx add "https://youtube.com/watch?v=..." fa --song-id j123456

  # Extract timestamps from existing audio
  songscript-whisperx extract downloads/song.m4a ko --pattern "첫째"

  # Match WhisperX output to existing lyrics
  songscript-whisperx match output/song_words.json lyrics.txt --pattern "برای"

  # Apply timestamps to database
  songscript-whisperx apply output/song_final.json j123456
"""

import os
import sys
import json
import argparse
import subprocess
from pathlib import Path
from typing import Optional, List, Dict, Any
from datetime import datetime

# Add current directory to path for imports
sys.path.insert(0, str(Path(__file__).parent))

from download import download_audio, get_video_info
from transcribe import transcribe_audio, format_output


# Language configurations
LANGUAGE_MODELS = {
    "fa": "jonatasgrosman/wav2vec2-large-xlsr-53-persian",
    "ko": "jonatasgrosman/wav2vec2-large-xlsr-53-korean",
    "ar": "jonatasgrosman/wav2vec2-large-xlsr-53-arabic",
    "he": "imvladikon/wav2vec2-xls-r-300m-hebrew",
}


class Colors:
    """Terminal colors for output."""
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    RED = '\033[91m'
    BOLD = '\033[1m'
    END = '\033[0m'


def print_step(step: str, msg: str):
    """Print formatted step message."""
    print(f"\n{Colors.BOLD}{Colors.BLUE}[{step}]{Colors.END} {msg}")


def print_success(msg: str):
    """Print success message."""
    print(f"{Colors.GREEN}✓ {msg}{Colors.END}")


def print_error(msg: str):
    """Print error message."""
    print(f"{Colors.RED}✗ {msg}{Colors.END}", file=sys.stderr)


def print_warning(msg: str):
    """Print warning message."""
    print(f"{Colors.YELLOW}⚠ {msg}{Colors.END}")


def ensure_venv():
    """Ensure we're running in the virtual environment."""
    venv_path = Path(__file__).parent / "venv"
    if not venv_path.exists():
        print_error("Virtual environment not found!")
        print("Run: python3 -m venv venv && source venv/bin/activate && pip install -r requirements.txt")
        sys.exit(1)

    # Check if running in venv
    if sys.prefix == sys.base_prefix:
        print_warning("Not running in virtual environment. Activating...")
        python_bin = venv_path / "bin" / "python3"
        if not python_bin.exists():
            python_bin = venv_path / "Scripts" / "python.exe"  # Windows

        if python_bin.exists():
            # Re-run this script with venv python
            os.execv(str(python_bin), [str(python_bin)] + sys.argv)
        else:
            print_error("Could not find venv python binary")
            sys.exit(1)


def cmd_add(args):
    """Add new song: full pipeline from YouTube to database."""
    print_step("ADD", f"Processing song from {args.url}")

    output_dir = Path(args.output_dir)
    downloads_dir = output_dir / "downloads"
    output_dir.mkdir(parents=True, exist_ok=True)
    downloads_dir.mkdir(parents=True, exist_ok=True)

    # Step 1: Download
    print_step("1/4", "Downloading audio")
    audio_path, video_info = download_audio(args.url, str(downloads_dir), format="wav")
    video_id = video_info.get("id", "unknown")
    print_success(f"Downloaded: {video_info.get('title', 'Unknown')}")

    # Step 2: Transcribe with WhisperX
    print_step("2/4", "Running WhisperX transcription")
    align_model = LANGUAGE_MODELS.get(args.language)
    if not align_model:
        print_warning(f"No alignment model for {args.language}, using default")

    result = transcribe_audio(
        audio_path,
        language=args.language,
        model_size=args.model,
        device=args.device
    )

    # Save raw WhisperX output
    whisperx_output = output_dir / f"{video_id}_whisperx_words.json"
    with open(whisperx_output, 'w', encoding='utf-8') as f:
        json.dump({
            'video_id': video_id,
            'title': video_info.get('title'),
            'segments': result.get('segments', []),
            'word_segments': result.get('word_segments', [])
        }, f, ensure_ascii=False, indent=2)

    print_success(f"WhisperX output saved: {whisperx_output}")

    # Step 3: Match to lines (if pattern provided)
    if args.pattern:
        print_step("3/4", f"Matching words to lines using pattern: {args.pattern}")
        # TODO: Implement generic pattern matching
        print_warning("Pattern matching not yet implemented - manual matching required")
        print(f"  1. Review {whisperx_output}")
        print(f"  2. Create custom match script based on final_timestamps.py")
        print(f"  3. Run: songscript-whisperx match {whisperx_output} <lyrics_file>")
    else:
        print_step("3/4", "Skipping line matching (no pattern)")
        # Use WhisperX segments as-is
        lines = format_output(result, include_words=True)
        final_output = output_dir / f"{video_id}_final_timestamps.json"
        with open(final_output, 'w', encoding='utf-8') as f:
            json.dump(lines, f, ensure_ascii=False, indent=2)
        print_success(f"Timestamps ready: {final_output}")

    # Step 4: Apply to database (if song-id provided)
    if args.song_id:
        print_step("4/4", f"Applying to database (song: {args.song_id})")
        final_output = output_dir / f"{video_id}_final_timestamps.json"
        if final_output.exists():
            apply_to_database(final_output, args.song_id, args.unlock_code)
        else:
            print_warning("Final timestamps not ready - skipping database update")
            print(f"Run: songscript-whisperx apply {final_output} {args.song_id}")
    else:
        print_warning("No song-id provided - skipping database update")

    print_success("Pipeline complete!")


def cmd_extract(args):
    """Extract timestamps from existing audio file."""
    print_step("EXTRACT", f"Processing {args.audio_file}")

    audio_path = Path(args.audio_file)
    if not audio_path.exists():
        print_error(f"Audio file not found: {args.audio_file}")
        sys.exit(1)

    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    # Run WhisperX
    print_step("1/2", "Running WhisperX transcription")
    result = transcribe_audio(
        str(audio_path),
        language=args.language,
        model_size=args.model,
        device=args.device
    )

    # Save output
    stem = audio_path.stem
    output_file = output_dir / f"{stem}_whisperx_words.json"
    with open(output_file, 'w', encoding='utf-8') as f:
        json.dump({
            'filename': audio_path.name,
            'segments': result.get('segments', []),
            'word_segments': result.get('word_segments', [])
        }, f, ensure_ascii=False, indent=2)

    print_success(f"Output saved: {output_file}")

    # Format lines
    print_step("2/2", "Formatting timestamps")
    lines = format_output(result, include_words=True)
    final_output = output_dir / f"{stem}_final_timestamps.json"
    with open(final_output, 'w', encoding='utf-8') as f:
        json.dump(lines, f, ensure_ascii=False, indent=2)

    print_success(f"Final timestamps: {final_output}")
    print(f"\nFound {len(lines)} segments")


def cmd_match(args):
    """Match WhisperX words to lyric lines using pattern detection."""
    print_step("MATCH", "Matching words to lines")

    whisperx_file = Path(args.whisperx_output)
    if not whisperx_file.exists():
        print_error(f"WhisperX output not found: {args.whisperx_output}")
        sys.exit(1)

    # Load WhisperX data
    with open(whisperx_file, 'r', encoding='utf-8') as f:
        whisperx = json.load(f)

    words = whisperx.get('word_segments', [])

    if args.pattern:
        print_step("1/2", f"Finding pattern: {args.pattern}")
        # Find all occurrences of pattern word
        pattern_positions = []
        for i, w in enumerate(words):
            if w.get('word') == args.pattern:
                pattern_positions.append({
                    'idx': i,
                    'start': w['start'],
                    'end': w['end'],
                    'next': words[i+1]['word'] if i+1 < len(words) else 'END'
                })

        print(f"Found {len(pattern_positions)} occurrences of '{args.pattern}'")

        # Interactive matching
        print_warning("Manual mapping required:")
        print(f"  1. Count lines in your lyrics that start with '{args.pattern}'")
        print(f"  2. Create mapping: line_num → pattern_index")
        print(f"  3. Update final_timestamps.py template with your mapping")
        print(f"\nPattern positions:")
        for i, pos in enumerate(pattern_positions):
            print(f"  {i}: {pos['start']:.2f}s → {pos['next']}")
    else:
        print_warning("No pattern provided - using WhisperX segments as-is")
        lines = whisperx.get('segments', [])
        output_file = Path(args.output_dir) / "matched_timestamps.json"
        with open(output_file, 'w', encoding='utf-8') as f:
            json.dump(lines, f, ensure_ascii=False, indent=2)
        print_success(f"Output: {output_file}")


def apply_to_database(timestamps_file: Path, song_id: str, unlock_code: str):
    """Apply timestamps to Convex database."""
    with open(timestamps_file, 'r', encoding='utf-8') as f:
        timestamps = json.load(f)

    # Format for Convex mutation
    updates = []
    for line in timestamps:
        updates.append({
            'lineNumber': line['lineNumber'],
            'startTime': line['startTime'],
            'endTime': line['endTime']
        })

    # Build Convex command
    cmd = [
        'npx', 'convex', 'run', 'lyrics:updateTimestamps',
        json.dumps({
            'songId': song_id,
            'unlockCode': unlock_code,
            'updates': updates
        })
    ]

    try:
        result = subprocess.run(cmd, check=True, capture_output=True, text=True, cwd='../..')
        print_success(f"Applied {len(updates)} timestamps to song {song_id}")
        print(result.stdout)
    except subprocess.CalledProcessError as e:
        print_error(f"Database update failed: {e.stderr}")
        sys.exit(1)


def cmd_apply(args):
    """Apply timestamps to database."""
    print_step("APPLY", f"Updating song {args.song_id}")

    timestamps_file = Path(args.timestamps_json)
    if not timestamps_file.exists():
        print_error(f"Timestamps file not found: {args.timestamps_json}")
        sys.exit(1)

    apply_to_database(timestamps_file, args.song_id, args.unlock_code)


def main():
    parser = argparse.ArgumentParser(
        description="SongScript WhisperX CLI - Unified song timestamp pipeline",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__
    )

    subparsers = parser.add_subparsers(dest='command', required=True)

    # ADD command
    add_parser = subparsers.add_parser('add', help='Full pipeline: YouTube to database')
    add_parser.add_argument('url', help='YouTube URL')
    add_parser.add_argument('language', help='Language code (fa, ko, ar, he)')
    add_parser.add_argument('--song-id', help='Song ID in database (optional)')
    add_parser.add_argument('--pattern', help='Pattern word for line matching (e.g., "برای")')
    add_parser.add_argument('--model', default='large-v3', help='Whisper model size')
    add_parser.add_argument('--device', default='auto', choices=['auto', 'cuda', 'cpu'])
    add_parser.add_argument('--output-dir', default='output', help='Output directory')
    add_parser.add_argument('--unlock-code', default='UNLOCK_TIMESTAMPS', help='Database unlock code')
    add_parser.set_defaults(func=cmd_add)

    # EXTRACT command
    extract_parser = subparsers.add_parser('extract', help='Extract from audio file')
    extract_parser.add_argument('audio_file', help='Path to audio file')
    extract_parser.add_argument('language', help='Language code (fa, ko, ar, he)')
    extract_parser.add_argument('--model', default='large-v3', help='Whisper model size')
    extract_parser.add_argument('--device', default='auto', choices=['auto', 'cuda', 'cpu'])
    extract_parser.add_argument('--output-dir', default='output', help='Output directory')
    extract_parser.set_defaults(func=cmd_extract)

    # MATCH command
    match_parser = subparsers.add_parser('match', help='Match words to lyric lines')
    match_parser.add_argument('whisperx_output', help='WhisperX JSON output')
    match_parser.add_argument('--pattern', help='Pattern word for line detection')
    match_parser.add_argument('--output-dir', default='output', help='Output directory')
    match_parser.set_defaults(func=cmd_match)

    # APPLY command
    apply_parser = subparsers.add_parser('apply', help='Apply timestamps to database')
    apply_parser.add_argument('timestamps_json', help='Final timestamps JSON file')
    apply_parser.add_argument('song_id', help='Song ID in database')
    apply_parser.add_argument('--unlock-code', default='UNLOCK_TIMESTAMPS', help='Database unlock code')
    apply_parser.set_defaults(func=cmd_apply)

    args = parser.parse_args()

    # Ensure venv is activated
    ensure_venv()

    # Run command
    try:
        args.func(args)
    except KeyboardInterrupt:
        print_error("\nAborted by user")
        sys.exit(1)
    except Exception as e:
        print_error(f"Error: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == '__main__':
    main()
